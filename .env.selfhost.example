# Copy to .env.selfhost or let `cloudops up` create it interactively.
# This example contains no usable secret values.
CLOUDOPS_DOMAIN=
CLOUDFLARE_TUNNEL_TOKEN=

APP_ENV=production
POSTGRES_DB=cloudops
POSTGRES_USER=cloudops
AWS_REGION=us-east-1

AI_PROVIDER=mock
NOTIFICATION_PROVIDER=mock
JIRA_ENABLED=false
AWS_BEDROCK_ENABLED=false
AWS_SES_ENABLED=false
AWS_SES_REGION=ap-south-1
# Must be a verified SES identity. Leave blank until verified.
AWS_SES_FROM_EMAIL=
AWS_SES_FROM_NAME=CloudOps
AWS_SES_REPLY_TO=
AWS_SES_CONFIGURATION_SET=
REMEDIATION_EXECUTION_ENABLED=false
REMEDIATION_LIVE_AWS_ENABLED=false
CLOUDOPS_INITIALIZED=false
