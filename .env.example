# Names and safe local defaults only. Copy to an untracked .env and set secrets there.
APP_ENV=
APP_NAME=
API_V1_PREFIX=
DATABASE_URL=
# Optional separate least-privilege Alembic credential. Defaults to DATABASE_URL locally.
MIGRATION_DATABASE_URL=
POSTGRES_TEST_DATABASE_URL=
JWT_SECRET_KEY=
JWT_ACTIVE_KEY_ID=
JWT_PREVIOUS_SECRET_KEY=
JWT_PREVIOUS_KEY_ID=
JWT_ALGORITHM=
ACCESS_TOKEN_EXPIRE_MINUTES=
REFRESH_TOKEN_EXPIRE_DAYS=
INVITATION_TOKEN_EXPIRE_HOURS=
CORS_ALLOWED_ORIGINS=
TRUSTED_HOSTS=
COOKIE_SECURE=
COOKIE_SAMESITE=
COOKIE_DOMAIN=
# Enable only when the production deployment guarantees HTTPS.
HSTS_ENABLED=
LOG_LEVEL=
FRONTEND_URL=
AUTH_RATE_LIMIT_PER_MINUTE=
AWS_TRUSTED_PRINCIPAL_ARN=
# Optional comma-separated exact runtime role ARNs; takes precedence over the singular field.
AWS_TRUSTED_PRINCIPAL_ARNS=
AWS_ROLE_SESSION_NAME=
AWS_ROLE_SESSION_DURATION_SECONDS=
AWS_CREDENTIAL_REFRESH_WINDOW_SECONDS=
AWS_DISCOVERY_REGIONS=
AWS_CONNECT_TIMEOUT_SECONDS=
AWS_READ_TIMEOUT_SECONDS=
AWS_MAX_RETRY_ATTEMPTS=
AWS_RETRY_MODE=
AI_PROVIDER=
AI_PROVIDER_API_KEY=
AWS_BEDROCK_ENABLED=
AWS_BEDROCK_REGION=
AWS_BEDROCK_MODEL_ID=
AWS_BEDROCK_MAX_TOKENS=
AWS_BEDROCK_TEMPERATURE=
AWS_BEDROCK_CONNECT_TIMEOUT_SECONDS=
AWS_BEDROCK_READ_TIMEOUT_SECONDS=
AWS_BEDROCK_MAX_RETRY_ATTEMPTS=
AWS_BEDROCK_MAX_REQUEST_BYTES=
AWS_BEDROCK_MAX_RESPONSE_BYTES=
NOTIFICATION_PROVIDER=
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
SMTP_USE_TLS=
SMTP_SECURITY=
SMTP_TIMEOUT_SECONDS=
AWS_SES_ENABLED=
AWS_SES_REGION=
AWS_SES_FROM_EMAIL=
AWS_SES_FROM_NAME=
AWS_SES_CONFIGURATION_SET=
AWS_SES_REPLY_TO=
AWS_SES_MAX_RECIPIENTS=
AWS_SES_CONNECT_TIMEOUT_SECONDS=
AWS_SES_READ_TIMEOUT_SECONDS=
AWS_SES_MAX_RETRY_ATTEMPTS=
REMEDIATION_EXECUTION_ENABLED=
REMEDIATION_LIVE_AWS_ENABLED=
REMEDIATION_EMERGENCY_STOP=true
NOTIFICATION_MAX_MESSAGE_BYTES=
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
WEBHOOK_TIMEOUT_SECONDS=
SCHEDULER_BATCH_SIZE=
SCHEDULER_POLL_INTERVAL_SECONDS=
JOB_LEASE_SECONDS=
JOB_POLL_INTERVAL_SECONDS=
JOB_SHUTDOWN_GRACE_SECONDS=
NOTIFICATION_PROVIDER_API_KEY=
# Global kill switch. Per-organization Jira connections (base URL, project, encrypted
# token) are configured by tenants at runtime and stored in the jira_integrations
# table, NOT here. When false, all Jira operations fail closed. Requires
# JIRA_TOKEN_ENCRYPTION_KEY to be set before it can be enabled.
JIRA_ENABLED=
# Base64/url-safe-base64-encoded 32-byte AES-256-GCM key used to encrypt per-organization
# Jira API tokens at rest. Production deployments should source this from a KMS-backed
# secret store, not a static environment variable committed anywhere.
JIRA_TOKEN_ENCRYPTION_KEY=
JIRA_CONNECT_TIMEOUT_SECONDS=
JIRA_READ_TIMEOUT_SECONDS=
JIRA_MAX_RETRY_ATTEMPTS=
# Local demo only. Replays seeded synthetic inventory instead of assuming a
# customer AWS role. Settings refuse this when APP_ENV is staging or production.
DEMO_SYNTHETIC_DISCOVERY=
# Local demo only. Accepts a genuinely same-origin Origin on the cookie-authenticated
# POST routes by comparing it to X-Forwarded-Host/-Proto from the reverse proxy, so an
# ephemeral tunnel hostname needs no CORS edit. Refused when APP_ENV is staging or
# production. Not a wildcard: the Origin must exactly equal the forwarded origin.
TRUST_FORWARDED_HOST_SAME_ORIGIN=
# Leave empty for the same-origin demo stack so the SPA calls relative /api/v1
# paths and Nginx proxies /api/ to the API container.
VITE_API_BASE_URL=
